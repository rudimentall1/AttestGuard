# --- Creditcoin (destination chain — where AttestGuardManager lives) ---
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_WALLET_PRIVATE_KEY=0xyour_testnet_private_key
ATTESTGUARD_MANAGER_ADDRESS=

# --- Source chain (where buyers confirm delivery — Sepolia in this demo) ---
SOURCE_CHAIN_RPC_URL=https://sepolia.infura.io/v3/your_infura_key
SOURCE_TRADE_CONFIRMATION_ADDRESS=
# Creditcoin's chainKey identifier for the source chain, per
# https://docs.creditcoin.org/attestcoin-protocol — confirm the current
# value for Sepolia against the deployment you're targeting before relying
# on the default here.
SOURCE_CHAIN_KEY=1

# --- Attestcoin Protocol proof service ---
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# --- Token used for advances (leave blank to auto-deploy a demo ERC20) ---
ADVANCE_TOKEN_ADDRESS=

# --- Policy defaults used at deploy time (see AttestGuardManager.sol) ---
GLOBAL_MAX_ADVANCE=5000
PER_SUPPLIER_DAILY_CAP=2000

# --- Off-chain worker ---
POLL_INTERVAL_MS=15000

# --- Optional: natural-language risk notes on the dashboard (advisory only,
# never gates a funding decision — see offchain-agent/src/explain.ts) ---
ANTHROPIC_API_KEY=
